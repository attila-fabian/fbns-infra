{
  "mcpServers": {
    "CloudFlare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp"
    },
    "unifi": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/pete-builds/mcp-unifi",
        "mcp-unifi"
      ],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "MCP_UNIFI_READONLY": "true",
        "STUB_MODE": "false",
        "UNIFI_HOST": "${UNIFI_HOST}",
        "UNIFI_PORT": "443",
        "UNIFI_SITE": "default",
        "UNIFI_VERIFY_SSL": "false",
        "UNIFI_API_KEY": "${UNIFI_API_KEY}",
        "LOG_FORMAT": "text",
        "LOG_LEVEL": "INFO"
      }
    }
  }
}
